{
  "name": "veyctum",
  "version": "0.1.0",
  "private": true,
  "description": "Telegraph ONCHAIN_TX_LOOKUP Miner: multi-chain transaction lookup with method decode, normalized Base ERC-20 effects, and inspectable evidence",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "fastify": "5.12.0",
    "pino": "10.3.1",
    "viem": "2.55.16",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
