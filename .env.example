# Veyctum Miner API environment
# Copy to .env and adjust values for your deployment. Never commit .env.

# HTTP server
PORT=8080
HOST=0.0.0.0

# Base identity for the Base-only consumer proof gate and USDC effects
BASE_CHAIN_ID=8453
BASE_CHAIN_NAME=base

# Official USDC contract on Base mainnet
# Source: https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Multi-chain auto-detection (comma list). The chain is auto-detected from the
# tx hash; a request chain hint is advisory only.
# Known chains: ethereum,base,arbitrum,optimism,polygon
ENABLED_CHAINS=ethereum,base

# Optional per-chain RPC overrides (defaults live in src/chains.ts).
# Two independent providers per chain for agreement checks.
# RPC_ETHEREUM_PRIMARY=https://eth.drpc.org
# RPC_ETHEREUM_FALLBACK=https://ethereum.publicnode.com
# RPC_BASE_PRIMARY=https://mainnet.base.org
# RPC_BASE_FALLBACK=https://base.drpc.org

# Required confirmations before a result is treated as definitive
REQUIRED_CONFIRMATIONS=2

# RPC timeout and total lookup budget, in milliseconds
RPC_TIMEOUT_MS=4000
LOOKUP_BUDGET_MS=9000

# Called-method decoding: local signature DB first, optional 4byte.directory fallback
FOURBYTE_ENABLED=true
FOURBYTE_URL=https://www.4byte.directory/api/v1/signatures/
FOURBYTE_TIMEOUT_MS=1200

# Public API rate limiting
RATE_LIMIT_PER_SEC=4
RATE_LIMIT_WINDOW_MS=1000

# Durable store for the reference consumer proof gate
# Use ':memory:' for tests.
CONSUMER_DB_PATH=./data/veyctum.db

# Reference consumer routes are protected separately from the public Miner API.
# Generate a long random value for production. Set CONSUMER_AUTH_REQUIRED=false
# only for local hermetic tests or an isolated development instance.
CONSUMER_AUTH_REQUIRED=true
CONSUMER_API_KEY=

# Telegraph Engine signal API used to verify release signals
TELEGRAPH_SIGNAL_API_URL=https://devnode.telegraphprotocol.com/engine/v1/signal/
TELEGRAPH_SIGNAL_TIMEOUT_MS=5000

# Public Miner metadata
MINER_NAME=veyctum
SCHEMA_VERSION=1.0.0
