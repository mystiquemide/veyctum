# Veyctum Miner API environment
# Copy to .env and fill values. Never commit .env.

# HTTP server
PORT=8080
HOST=0.0.0.0

# Fixed Base environment (ADR-003). Do not change.
BASE_CHAIN_ID=8453
BASE_CHAIN_NAME=base
# Allowlisted token contract on Base mainnet (Circle USDC) - official source:
# https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Independent RPC providers (FR-005). Primary + fallback.
RPC_URL_PRIMARY=https://mainnet.base.org
RPC_URL_FALLBACK=https://base.drpc.org

# Finality: required confirmations before a result is definitive (FR-006)
REQUIRED_CONFIRMATIONS=2

# Per-provider RPC timeout in ms and total lookup budget in ms (upstream <= 8000ms per plan)
RPC_TIMEOUT_MS=4000
LOOKUP_BUDGET_MS=8000

# Miner public config (used for documentation/tests, non-secret)
MINER_NAME=veyctum
SCHEMA_VERSION=1.0.0