# Veyctum Miner API environment
# Copy to .env and adjust values for your deployment. Never commit .env.

# HTTP server
PORT=8080
HOST=0.0.0.0

# Fixed Base environment
BASE_CHAIN_ID=8453
BASE_CHAIN_NAME=base

# Official USDC contract on Base mainnet
# Source: https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Independent RPC providers used for agreement checks
RPC_URL_PRIMARY=https://mainnet.base.org
RPC_URL_FALLBACK=https://base.drpc.org

# Required confirmations before a result is treated as definitive
REQUIRED_CONFIRMATIONS=2

# RPC timeout and total lookup budget, in milliseconds
RPC_TIMEOUT_MS=4000
LOOKUP_BUDGET_MS=8000

# Public API rate limiting
RATE_LIMIT_PER_SEC=4
RATE_LIMIT_WINDOW_MS=1000

# Durable store for the reference consumer proof gate
# Use ':memory:' for tests.
CONSUMER_DB_PATH=./data/veyctum.db

# Telegraph Engine signal API used to verify release signals
TELEGRAPH_SIGNAL_API_URL=https://devnode.telegraphprotocol.com/engine/v1/signal/
TELEGRAPH_SIGNAL_TIMEOUT_MS=5000

# Public Miner metadata
MINER_NAME=veyctum
SCHEMA_VERSION=1.0.0
